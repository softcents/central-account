# ==============================================================================
# Central Account Platform — Production Environment Configuration
# ==============================================================================

# --- Database (PostgreSQL 17) ---
POSTGRES_USER=central_account_admin
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_RANDOM_PASSWORD_64_CHARS
POSTGRES_DB=central_account_prod
POSTGRES_PORT=5432

# --- Cache & Queues (Redis 7 + BullMQ) ---
REDIS_PORT=6379

# --- Application Security Secrets ---
# (Generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_CRYPTOGRAPHIC_KEY_MIN_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_CRYPTOGRAPHIC_KEY_MIN_32_CHARS
JWT_MFA_SECRET=REPLACE_WITH_RANDOM_CRYPTOGRAPHIC_KEY_MIN_32_CHARS
INTERNAL_SERVICE_SECRET=REPLACE_WITH_RANDOM_CRYPTOGRAPHIC_KEY_MIN_32_CHARS

# --- Domains & URLs (HTTPS is MANDATORY for Camera/Face Verification) ---
# Example: https://id.yourdomain.com
FRONTEND_URL=https://id.yourdomain.com
NEXT_PUBLIC_API_URL=https://id.yourdomain.com/api

# --- Transactional Email (SMTP / SendGrid / Amazon SES / Postmark) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=YOUR_SENDGRID_OR_SES_API_KEY
SMTP_FROM="Central Account Security" <noreply@yourdomain.com>

# --- Private Object Storage (Encrypted Government ID & Trade License Storage) ---
# Supports AWS S3, Cloudflare R2, MinIO, or DigitalOcean Spaces
STORAGE_DRIVER=s3
AWS_ACCESS_KEY_ID=YOUR_AWS_OR_R2_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_OR_R2_SECRET_KEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=central-account-private-documents
